#include "swweeep_common.dtsi"

// Aptmak base layer, built as the swweeep_left-aptmak firmware.

/ {
    keymap {
        compatible = "zmk,keymap";

    default_layer {
            bindings = <
    &kp V        &kp W       &kp F       &kp P        &kp B          &kp J       &kp L          &kp U       &kp Y       &kp SEMI
    &hl LCTRL R  &hl LALT S  &hl LGUI T  &hl LSHFT H  &hl RALT K     &hr RALT X  &hr RSHFT N    &hr LGUI A  &hr LALT I  &hr RCTRL O
    &kp Z        &kp C       &kp G       &kp D        &kp Q          &kp SQT     &kp M          &comsem     &dotcol     &kp FSLH
                             &lt BT ESC  &lt NUM SQT  &lt NAV SPACE  &lt SYM E   &lt FUN ENTER  &kp TAB
            >;
        };
    };
};

#include "swweeep_layers.dtsi"
